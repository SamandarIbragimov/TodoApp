# Lokal ishlash uchun True, productionda False (sukut: False)
DEBUG=True
# Production'da majburiy: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Bo'sh qolsa SQLite ishlatiladi
DATABASE_URL=
# Production'da: HTTPS'ga yo'naltirish va HSTS (soniya). Domen HTTPS'ga tayyor bo'lmasa 0
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
LOG_LEVEL=INFO
